{
  "type": "object",
  "required": [
    "canonical_ingredient",
    "product_ids",
    "status",
    "evidence"
  ],
  "properties": {
    "canonical_ingredient": {
      "type": "string"
    },
    "product_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "verified_available",
        "likely_available",
        "unknown",
        "unavailable"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
