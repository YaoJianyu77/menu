{
  "type": "object",
  "required": [
    "id",
    "raw_id",
    "title",
    "source_url",
    "source_license",
    "ingredients",
    "instructions",
    "active_minutes",
    "total_minutes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "source": {
      "type": "string"
    },
    "retrieved_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT.*[+-]\\d\\d:\\d\\d$"
    },
    "raw_id": {
      "type": "string"
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "canonical_ingredient",
          "original_text",
          "quantity",
          "unit",
          "optional"
        ],
        "properties": {
          "quantity": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "enum": [
              "g",
              "kg",
              "mL",
              "L",
              null
            ]
          },
          "optional": {
            "type": "boolean"
          }
        }
      }
    },
    "active_minutes": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "total_minutes": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
