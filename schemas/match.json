{
  "type": "object",
  "required": [
    "recipe_id",
    "total_score",
    "status",
    "foodlion_coverage",
    "ingredient_matches",
    "input_fingerprint",
    "verified_ingredient_count",
    "likely_ingredient_count",
    "unknown_ingredient_count",
    "unsupported_ingredient_count",
    "foodlion_verified_coverage",
    "foodlion_confidence",
    "recommendation_status"
  ],
  "properties": {
    "recipe_id": {
      "type": "string"
    },
    "total_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "foodlion_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "enum": [
        "approved",
        "rejected",
        "needs-review"
      ]
    },
    "ingredient_matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "canonical_ingredient",
          "status",
          "product_ids"
        ],
        "properties": {
          "status": {
            "enum": [
              "verified_available",
              "likely_available",
              "unknown",
              "unavailable"
            ]
          }
        }
      }
    },
    "verified_ingredient_count": {
      "type": "integer",
      "minimum": 0
    },
    "likely_ingredient_count": {
      "type": "integer",
      "minimum": 0
    },
    "unknown_ingredient_count": {
      "type": "integer",
      "minimum": 0
    },
    "unsupported_ingredient_count": {
      "type": "integer",
      "minimum": 0
    },
    "foodlion_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 40
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
